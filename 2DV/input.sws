$*******************************************************************
$  SWASH input file
$  1D planar beach, JONSWAP spectrum
$
$  Domain          : 600 m cross-shore
$  Bathymetry      : planar 1/50 slope (h_off = 10 m, x_shore = 500 m)
$  Forcing         : JONSWAP, Hs = 1.0 m, Tp = 10 s, gamma = 3.3
$  Layers          : 2
$  Breaking        : HSWE switch, alpha = 0.6
$  Friction        : Manning, n = 0.019 (sandy beach)
$  Duration        : 30 min (dt = 0.05 s)
$
$  Companion: make_bathy.py generates bot.txt
$*******************************************************************

PROJECT 'jonswap1D' '01' &
        'Planar 1D beach, JONSWAP forcing'

$-- run mode
MODE NONSTATIONARY ONEDIMENSIONAL
COORDINATES CARTESIAN

$-- computational grid
$   600 m long, dx = 1 m  600 cells (mxc = 600, myc = 0 for 1D)
CGRID REGULAR 0. 0. 0. 600. 0. 600 0

$-- vertical resolution
VERTICAL 2

$-- bathymetry input
$   INPGRID matches the computational grid in 1D (601 nodes)
INPGRID BOTTOM REGULAR 0. 0. 0. 600 0 1. 0.
READINP BOTTOM 1. 'bot.txt' 4 0 FREE

$-- initial condition: still water
INIT ZERO

$-- JONSWAP boundary spectrum
$   PEAK     : Tp is peak period (MEAN would mean mean period)
BOUND SHAPESPEC JONSWAP 3.3 PEAK DSPR POWER

$-- west boundary: weakly reflective, 30s smooth start-up,
$   irregular spectrum (Hs=1, Tp=10, theta=0, ms=4)
BOUNDCOND SIDE W BTYPE WEAK SMOOTHING 30 SEC CONSTANT SPECTRUM 1.0 10. 0. 0.

$-- bottom friction
FRICTION MANNING 0.019

$-- depth-induced breaking via the hydrostatic front approxmation (alpha = 0.6)
BREAK 0.6

$-- non-hydrostatic pressure (Keller-box compact)
NONHYDROSTATIC BOX 1.

$-- numerics: upwind momentum, depth-corrected pressure
DISCRETIZATION UPW MOMENTUM
DISCRETIZATION CORRDEP

$===================================================================
$  OUTPUT
$===================================================================
$-- wave gauges (offshore to shoreline)
POINTS 'g050'  50.  0.
POINTS 'g100' 100.  0.
POINTS 'g200' 200.  0.
POINTS 'g300' 300.  0.
POINTS 'g400' 400.  0.
POINTS 'g450' 450.  0.
POINTS 'g480' 480.  0.

$-- time series at each gauge (water level and depth-averaged velocity)
TABLE 'g050' NOHEAD 'g050.dat' TSEC WATL VEL OUTPUT 000000.000 0.2 SEC
TABLE 'g100' NOHEAD 'g100.dat' TSEC WATL VEL OUTPUT 000000.000 0.2 SEC
TABLE 'g200' NOHEAD 'g200.dat' TSEC WATL VEL OUTPUT 000000.000 0.2 SEC
TABLE 'g300' NOHEAD 'g300.dat' TSEC WATL VEL OUTPUT 000000.000 0.2 SEC
TABLE 'g400' NOHEAD 'g400.dat' TSEC WATL VEL OUTPUT 000000.000 0.2 SEC
TABLE 'g450' NOHEAD 'g450.dat' TSEC WATL VEL OUTPUT 000000.000 0.2 SEC
TABLE 'g480' NOHEAD 'g480.dat' TSEC WATL VEL OUTPUT 000000.000 0.2 SEC

$-- full free-surface field with snapshots every 1s after a 60s spinup
BLOCK 'COMPGRID' NOHEAD 'wlev.txt' LAYOUT 3 WATL &
      OUTPUT 000100.000 1. SEC
BLOCK 'COMPGRID' NOHEAD 'vel.txt' LAYOUT 3 VELK VEL &
      OUTPUT 000100.000 1. SEC
$===================================================================
$  RUN
$===================================================================
$-- 30-min simulation, dt = 0.05 s
COMPUTE NONSTATIONARY 000000.000 0.05 SEC 003000.000
STOP