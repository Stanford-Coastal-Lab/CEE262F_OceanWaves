$*************HEADING****************************************
$
PROJ 'DUCK94' 'D94'
$
$ DUCK94 2D field experiment. Simulation set by Simon Treillou.
$
$***********MODEL INPUT**********************************
$
MODE DYN ONED
$
SET backvisc=0.0001
SET seed=12345
SET level=0.0
$
VERTICAL 20 
$3.64 4.81 5.83 6.65 7.19 7.5 7.52 7.35 6.98 6.48 5.92 5.32 4.76 4.23 3.77 3.39 3.1 2.86 2.7
$
CGRID 100. 0. 0. 381. 0. 761 0
$
INPGRID BOTTOM 100. 0. 0. 761 0 0.5 0.
READINP BOTTOM 1. 'planar_s002.bot' 1 0 FREE
$
INIT zero
$
BOU SHAPESPEC JONSWAP 2.0 SIG PEAK DSPR DEGREES
BOU SIDE E CCW BTYPE WEAK SMOO 10 SEC CON SPECT 1.6 6.6 0.0 CYCLE 3600 SEC
BOU SIDE W CCW BTYPE RADIATION
$
VISC Vertical KEPS
FRIC LOG ROUGH 0.001
NONHYDROSTATIC STANDARD PREC ILU
$
DISCRET UPW UMOM MOM HORIZONTAL QUICK
DISCRET UPW WMOM HORIZONTAL QUICK
DISCRET UPW UMOM MOM VERT QUICK
DISCRET UPW WMOM VERT QUICK
DISCRET CORRDEP MUS
$
TIMEI 0.1 0.5
$
$************ OUTPUT REQUESTS *************************
$
QUANT XP HEXP 10.
QUANT HS SETUP DUR 10 MIN
QUANT MVKSIK DUR 10 MIN
$
FRAME 'GRID'   100. 0. 0. 381. 0. 761  0
BLOCK 'GRID'   NOHEAD 'u.mat' LAY 3 XP BOTL VKSIK OUTPUT 000000.000 0.5 SEC
BLOCK 'GRID'   NOHEAD 'zeta.mat' LAY 3 XP BOTL WATL OUTPUT 000000.000 0.5 SEC
BLOCK 'GRID'   NOHEAD 'tke.mat' LAY 3 XP BOTL TKE OUTPUT 000000.000 0.5 SEC
BLOCK 'GRID'   NOHEAD 'Akv.mat' LAY 3 XP BOTL VISC OUTPUT  000000.000 0.5 SEC
BLOCK 'GRID'   NOHEAD 'eps.mat' LAY 3 XP BOTL EPS OUTPUT  000000.000 0.5 SEC
TABLE 'GRID'   NOHEAD   'umean.mat' MVKSIK 
TABLE 'GRID'   NOHEAD   'hs.mat' XP HS
POINTS 'GAUGE' FILE 'stations.loc'
TABLE  'GAUGE' NOHEAD 'stations.tbl' TSEC XP BOTL WATL VKSIK OUTPUT 000000.000 0.5 SEC
$
TEST 1 0
COMPUTE 000000.000 0.005 SEC 001000.000
STOP
